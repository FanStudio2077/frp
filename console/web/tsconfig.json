{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/*": [
        "../../web/shared/*"
      ],
      "@frpc/*": [
        "../../web/frpc/src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "src/**/*.vue",
    "test/**/*"
  ]
}