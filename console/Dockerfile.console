FROM node:22 AS web
WORKDIR /web
COPY console/web/package.json ./package.json
RUN npm install --no-audit --no-fund
COPY console/web/ ./
RUN npm run build

FROM golang:1.26 AS build
WORKDIR /src
COPY console/backend/go.mod ./go.mod
RUN go mod download || true
COPY console/backend/ ./
RUN CGO_ENABLED=0 go build -o /out/console ./cmd/console

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/console /usr/bin/console
COPY --from=web /web/dist /app/web
WORKDIR /app
ENV CONSOLE_LISTEN=:8080
EXPOSE 8080
ENTRYPOINT ["/usr/bin/console"]
