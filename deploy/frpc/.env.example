# 复制为 .env 并按需修改
FRP_SERVER_ADDR=1.2.3.4
FRP_SERVER_PORT=7000
FRP_TOKEN=CHANGE_ME_TOKEN

FRP_WEB_PORT=7400
FRP_WEB_USER=admin
FRP_WEB_PASS=change-me

# 可选：多服务器（TOML 片段，用 \n 换行）
# FRP_SERVERS=servers = [\n  { name = "main", serverAddr = "1.2.3.4", serverPort = 7000, priority = 0, enabled = true },\n]

# 可选：代理（TOML 片段，用 \n 换行）
# FRP_PROXIES=[[proxies]]\nname = "ssh"\ntype = "tcp"\nlocalIP = "127.0.0.1"\nlocalPort = 22\nremotePort = 6000
